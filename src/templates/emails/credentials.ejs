<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>LabNet Guardian Login Credentials</title>
    <style>
      body {
        margin: 0;
        padding: 0;
        background: #f3f6fb;
        font-family: Arial, Helvetica, sans-serif;
        color: #1f2937;
      }

      .container {
        max-width: 640px;
        margin: 0 auto;
        padding: 32px 16px;
      }

      .card {
        background: #ffffff;
        border-radius: 16px;
        padding: 32px;
        box-shadow: 0 12px 30px rgba(15, 23, 42, 0.08);
      }

      .title {
        margin: 0 0 8px;
        font-size: 24px;
        color: #0f172a;
      }

      .subtitle {
        margin: 0 0 24px;
        color: #475569;
        line-height: 1.6;
      }

      .credentials {
        width: 100%;
        border-collapse: collapse;
        margin: 24px 0;
        overflow: hidden;
        border-radius: 12px;
      }

      .credentials td {
        padding: 14px 16px;
        border-bottom: 1px solid #e2e8f0;
      }

      .label {
        width: 120px;
        font-weight: 700;
        color: #334155;
        background: #f8fafc;
      }

      .footer {
        margin-top: 24px;
        font-size: 14px;
        color: #64748b;
        line-height: 1.6;
      }

      .note {
        display: inline-block;
        margin-top: 8px;
        padding: 12px 16px;
        border-radius: 12px;
        background: #eff6ff;
        color: #1d4ed8;
        font-size: 14px;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="card">
        <h1 class="title">Your LabNet Guardian account is ready</h1>
        <p class="subtitle">
          Hello <%= firstName %>, your account has been created successfully.
          Use the credentials below to sign in.
        </p>

        <table class="credentials" role="presentation">
          <tr>
            <td class="label">Email</td>
            <td><%= email %></td>
          </tr>
          <tr>
            <td class="label">Password</td>
            <td><%= password %></td>
          </tr>
          <tr>
            <td class="label">Role</td>
            <td><%= role %></td>
          </tr>
        </table>

        <div class="note">
          Please change your password after your first login.
        </div>

        <p class="footer">
          If you did not expect this email, please contact your system
          administrator.
        </p>
      </div>
    </div>
  </body>
</html>
