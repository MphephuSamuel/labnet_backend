<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>LabNet Guardian — Reset Password</title>
    <style>
      :root {
        --bg: #f6f8fb;
        --card: #ffffff;
        --muted: #64748b;
        --text: #0f172a;
        --accent-600: #2563eb;
        --accent-400: #60a5fa;
        --danger: #ef4444;
        --radius: 14px;
        --shadow: 0 10px 30px rgba(2, 6, 23, 0.08);
        --mono: "Inter", "Segoe UI", Roboto, system-ui, -apple-system, Arial;
      }
      html,
      body {
        height: 100%;
      }
      body {
        margin: 0;
        font-family: var(--mono);
        background: linear-gradient(180deg, #f8fafc 0%, var(--bg) 100%);
        color: var(--text);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        padding: 36px 16px;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .wrapper {
        width: 100%;
        max-width: 700px;
      }
      .card {
        background: var(--card);
        border-radius: calc(var(--radius) + 6px);
        box-shadow: var(--shadow);
        overflow: hidden;
      }
      .header {
        padding: 28px 28px 20px 28px;
        display: flex;
        gap: 16px;
        align-items: center;
        background: linear-gradient(
          90deg,
          rgba(37, 99, 235, 0.08),
          rgba(239, 68, 68, 0.04)
        );
      }
      .logo {
        width: 56px;
        height: 56px;
        display: inline-grid;
        place-items: center;
        background: linear-gradient(
          135deg,
          var(--accent-600),
          var(--accent-400)
        );
        color: white;
        font-weight: 700;
        border-radius: 12px;
        flex-shrink: 0;
      }
      .brand {
        display: flex;
        flex-direction: column;
      }
      .brand .app {
        font-size: 18px;
        font-weight: 700;
        color: var(--text);
        margin: 0;
      }
      .brand .meta {
        font-size: 13px;
        color: var(--muted);
        margin-top: 4px;
      }
      .content {
        padding: 28px;
      }
      h1 {
        margin: 0 0 10px 0;
        font-size: 20px;
        color: var(--text);
      }
      p.lead {
        margin: 0 0 20px 0;
        color: var(--muted);
        line-height: 1.6;
      }
      .cta {
        display: flex;
        gap: 12px;
        align-items: center;
        margin-top: 16px;
        flex-wrap: wrap;
      }
      .btn {
        display: inline-block;
        text-decoration: none;
        background: linear-gradient(
          90deg,
          var(--accent-600),
          var(--accent-400)
        );
        color: white;
        padding: 12px 18px;
        border-radius: 10px;
        font-weight: 600;
        box-shadow: 0 8px 18px rgba(37, 99, 235, 0.12);
      }
      .secondary {
        color: var(--accent-600);
        background: transparent;
        border: 1px solid rgba(59, 130, 246, 0.12);
        padding: 10px 14px;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 600;
      }
      .note {
        margin-top: 16px;
        display: inline-block;
        padding: 12px 16px;
        border-radius: 10px;
        background: #fef2f2;
        color: var(--danger);
        font-size: 14px;
      }
      .footer {
        padding: 18px 28px;
        background: #ffffff;
        border-top: 1px solid #f1f5f9;
        color: var(--muted);
        font-size: 13px;
        line-height: 1.5;
      }
      @media (max-width: 520px) {
        .header {
          padding: 18px;
        }
        .content {
          padding: 20px;
        }
        .footer {
          padding: 16px;
        }
        .logo {
          width: 48px;
          height: 48px;
          border-radius: 10px;
        }
        .brand .app {
          font-size: 16px;
        }
      }
    </style>
  </head>
  <body
    style="
      margin: 0;
      font-family:
        Inter,
        Segoe UI,
        Roboto,
        system-ui,
        -apple-system,
        Arial;
      background: linear-gradient(180deg, #f8fafc 0%, #f6f8fb 100%);
      color: #0f172a;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      padding: 36px 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100%;
    "
  >
    <div
      class="wrapper"
      role="article"
      aria-label="LabNet Guardian password reset"
    >
      <div
        class="card"
        role="document"
        style="
          width: 100%;
          max-width: 700px;
          background: #ffffff;
          border-radius: 20px;
          box-shadow: 0 10px 30px rgba(2, 6, 23, 0.08);
          overflow: hidden;
        "
      >
        <div
          class="header"
          style="
            padding: 28px 28px 20px 28px;
            display: flex;
            gap: 16px;
            align-items: center;
            background: linear-gradient(
              90deg,
              rgba(37, 99, 235, 0.08),
              rgba(239, 68, 68, 0.04)
            );
          "
        >
          <div
            class="logo"
            aria-hidden="true"
            style="
              width: 56px;
              height: 56px;
              display: inline-grid;
              place-items: center;
              background: linear-gradient(135deg, #2563eb, #60a5fa);
              color: #ffffff;
              font-weight: 700;
              border-radius: 12px;
              flex-shrink: 0;
            "
          >
            LG
          </div>
          <div class="brand">
            <p
              class="app"
              style="
                font-size: 18px;
                font-weight: 700;
                color: #0f172a;
                margin: 0;
              "
            >
              LabNet Guardian
            </p>
            <p
              class="meta"
              style="
                font-size: 13px;
                color: #64748b;
                margin-top: 4px;
                margin: 0;
              "
            >
              Password reset request
            </p>
          </div>
        </div>
        <div class="content" style="padding: 28px">
          <h1 style="margin: 0 0 10px 0; font-size: 20px; color: #0f172a">
            Reset your password, <%= firstName %>
          </h1>
          <p
            class="lead"
            style="margin: 0 0 20px 0; color: #64748b; line-height: 1.6"
          >
            We received a request to reset the password for <%= email %>. Use
            the button below to choose a new password.
          </p>
          <div class="cta" role="group" aria-label="Password reset actions">
            <a
              href="<%= resetUrl %>"
              class="btn"
              style="
                display: inline-block;
                text-decoration: none;
                color: #ffffff;
                background-color: #2563eb;
                padding: 12px 18px;
                border-radius: 10px;
                font-weight: 600;
                box-shadow: 0 8px 18px rgba(37, 99, 235, 0.12);
              "
              target="_blank"
              rel="noopener noreferrer"
            >
              Reset password
            </a>
            <a
              href="<%= resetUrl %>"
              class="secondary"
              style="
                display: inline-block;
                text-decoration: none;
                color: #2563eb;
                background: transparent;
                border: 1px solid rgba(59, 130, 246, 0.12);
                padding: 10px 14px;
                border-radius: 10px;
                font-weight: 600;
              "
              target="_blank"
              rel="noopener noreferrer"
            >
              Open reset link
            </a>
          </div>
          <div
            class="note"
            role="status"
            style="
              margin-top: 16px;
              display: inline-block;
              padding: 12px 16px;
              border-radius: 10px;
              background: #fef2f2;
              color: #dc2626;
              font-size: 14px;
            "
          >
            This link expires in 15 minutes. If you did not request it, you can
            ignore this email.
          </div>
        </div>
        <div
          class="footer"
          style="
            padding: 18px 28px;
            background: #ffffff;
            border-top: 1px solid #f1f5f9;
            color: #64748b;
            font-size: 13px;
            line-height: 1.5;
          "
        >
          If the button does not work, copy and paste this link into your
          browser: <%= resetUrl %>
        </div>
      </div>
    </div>
  </body>
</html>
